#!/bin/sh
# find-tool "<what you want to do>": the 5 most relevant installed tools (distinct), via `moss query`.
# Moss credentials: MOSS_PROJECT_ID and MOSS_PROJECT_KEY from ~/.config/find-tool/.env (or the file in
# FIND_TOOL_ENV), which override any MOSS_* already set; without that file, the Moss CLI's own lookup
# (MOSS_* env vars, then ~/.moss/config.json from `moss init`).
# Queries 20 docs and keeps the first 5 distinct tools (tools with many subcommands would otherwise fill all 5).
# Paths under $HOME are shown as ~/...
#
# On a terminal: tool name in color, description on the next line, fitted to the terminal width.
# Piped (scripts, agents): one line per tool, `name [sub] (kind, path): description`.
#   FIND_TOOL_INDEX        index name (default find-tool)
#   FIND_TOOL_COLOR        ANSI color for tool names (default 1;36, bold cyan; empty or NO_COLOR set: no color)
#   FIND_TOOL_DESC_CHARS   description length (default: terminal width - 2, or 160 when piped)
#
# find-tool --init      build the index from $PATH and agent skills, replacing any existing one (~1-2 min)
# find-tool --add-new   index only CLIs not in the index yet, and refresh skills (keeps the index online)
# Both run `<tool> --help` for user-installed tools only; every call is logged (path printed at the end).
[ -n "$1" ] || { echo 'usage: find-tool "<what you want to do>" | --init | --add-new' >&2; exit 2; }
env_file=${FIND_TOOL_ENV:-$HOME/.config/find-tool/.env}
if [ -n "${FIND_TOOL_ENV-}" ] || [ -e "$env_file" ]; then
  # Read (never source) KEY=value, optionally `export`-prefixed and quoted; the last match wins.
  get() { sed -n "s/^[[:space:]]*\(export[[:space:]]*\)\{0,1\}$1[[:space:]]*=[[:space:]]*//p" "$env_file" 2>/dev/null |
    tail -n 1 | sed "s/[[:space:]]*\$//; s/^[\"']\(.*\)[\"']\$/\1/"; }
  MOSS_PROJECT_ID=$(get MOSS_PROJECT_ID) MOSS_PROJECT_KEY=$(get MOSS_PROJECT_KEY)
  [ -n "$MOSS_PROJECT_ID" ] && [ -n "$MOSS_PROJECT_KEY" ] ||
    { echo "find-tool: $env_file must set MOSS_PROJECT_ID and MOSS_PROJECT_KEY" >&2; exit 2; }
  export MOSS_PROJECT_ID MOSS_PROJECT_KEY
  FIND_TOOL_INDEX=${FIND_TOOL_INDEX:-$(get FIND_TOOL_INDEX)}
fi
index=${FIND_TOOL_INDEX:-find-tool}
case $1 in --init|--add-new)
  dir=$(mktemp -d) || exit 1
  build=$(dirname "$(readlink -f "$0")")/../build.py
  if [ "$1" = --add-new ]; then
    moss --json doc get "$index" | jq -r '.[] | select(.metadata.kind == "cli") | .metadata.name' > "$dir/skip" &&
      python3 "$build" --skip "$dir/skip" --log "$dir/help-calls.log" > "$dir/docs.json" &&
      moss doc add "$index" -f "$dir/docs.json" --upsert --wait
  else
    python3 "$build" --log "$dir/help-calls.log" > "$dir/docs.json" &&
      { ! moss index get "$index" > /dev/null 2>&1 || moss index delete "$index" -y; } &&
      moss index create "$index" -f "$dir/docs.json" --wait
  fi
  status=$?
  echo "find-tool: documents and --help log in $dir" >&2
  exit $status ;;
esac
if [ -t 1 ]; then
  pretty=1
  max=${FIND_TOOL_DESC_CHARS:-$(( $(tput cols 2>/dev/null || echo 80) - 2 ))}
  color=${FIND_TOOL_COLOR-1;36}
  [ -n "${NO_COLOR-}" ] && color=
else
  pretty=0 max=${FIND_TOOL_DESC_CHARS:-160} color=
fi
moss --json query "$index" "$*" -k 20 |
  jq -r --arg home "$HOME/" --arg pretty "$pretty" --arg color "$color" --argjson max "$max" '
  reduce .docs[] as $d ([]; if any(.[]; .metadata.name == $d.metadata.name) then . else . + [$d] end)
  | .[:5][]
  | (.metadata.path | if startswith($home) then "~/" + .[($home | length):] else . end) as $path
  | (.metadata.name + (if .metadata.sub then " " + .metadata.sub else "" end)) as $name
  | if $pretty == "1" then
      (if $color == "" then $name else "\u001b[\($color)m\($name)\u001b[0m" end)
      + "  (\(.metadata.kind), \($path))\n  " + (.text | ltrimstr($name + ": ") | sub("^\\s+"; "") | .[0:$max])
    else "\($name) (\(.metadata.kind), \($path)): \(.text | .[0:$max])" end'
